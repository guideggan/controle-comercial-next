# Copie para .env e preencha com valores reais (nunca commitar .env).

# String de conexão do Postgres (Neon em produção; Postgres local/Neon branch em dev).
# Ex.: postgresql://user:pass@host:5432/controle_comercial_next?schema=public
DATABASE_URL=

# Better Auth
# Gerar com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL base da aplicação (http://localhost:3000 em dev)
BETTER_AUTH_URL=

# Seed do admin inicial (prisma/seed.ts, plano 05) — nunca hardcodar senha no script.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
