# Copie para .env e preencha com valores reais (nunca commitar .env).

# String de conexão do Postgres (Neon em produção; Postgres local/Neon branch em dev).
# Use o host POOLED (com "-pooler" no endpoint id) — reduz drasticamente a
# latência de conexão em cada query já que o Neon direto está em us-east-1
# sem pooling. Ex.: postgresql://user:pass@ep-xxx-pooler.região.aws.neon.tech/db?sslmode=require&pgbouncer=true
DATABASE_URL=

# String de conexão DIRETA (sem "-pooler") — usada só para migrations
# (prisma migrate deploy/status), que precisam de uma conexão não-pooled.
# Ex.: postgresql://user:pass@ep-xxx.região.aws.neon.tech/db?sslmode=require
DIRECT_URL=

# Better Auth
# Gerar com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL base da aplicação (http://localhost:3000 em dev)
BETTER_AUTH_URL=

# Seed do admin inicial (prisma/seed.ts, plano 05) — nunca hardcodar senha no script.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Opcional — default "Admin" se omitido.
SEED_ADMIN_NOME=
