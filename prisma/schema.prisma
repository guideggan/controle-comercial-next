// ============================================================
// CONVENÇÕES DE TIPOS — TRAVADAS NA FASE 1 (fundação)
// ============================================================
// Dinheiro:     Decimal @db.Decimal(14, 2)  → Postgres NUMERIC(14,2). Nunca Float/Int.
// Percentual:   Decimal @db.Decimal(6, 4)   → Postgres NUMERIC(6,4)  (ex.: 0.0125 = 1,25%).
// Data-only:    DateTime @db.Date           → Postgres DATE (ex.: mês de referência, vencimento).
//               Tratar como string "YYYY-MM-DD" na borda da aplicação; nunca fazer
//               round-trip por um Date do JS ciente de timezone para comparação/exibição.
// Instantes:    DateTime @db.Timestamptz    → Postgres TIMESTAMPTZ (createdAt/updatedAt,
//               "quando foi marcado como pago" etc). Converter para America/Sao_Paulo
//               somente na renderização (Intl/date-fns-tz), nunca hardcodar offset UTC-3.
//
// Fase 1 ainda não tem tabelas de dinheiro (sem venda/parcela), mas Colaborador e
// Produto já seguem a convenção de instantes (Timestamptz) para que as fases 2+
// encaixem sem migração de tipo depois.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer) — usado em runtime pela aplicação. O Neon direto
  // (us-east-1, sem pooling) cria uma conexão TCP+TLS nova por request,
  // dominando o tempo de navegação; o pooler reaproveita conexões.
  url       = env("DATABASE_URL")
  // Direto (sem "-pooler") — usado só por `prisma migrate`/`db push`, que
  // exigem uma conexão não-pooled para funcionar corretamente.
  directUrl = env("DIRECT_URL")
}

enum Papel {
  ADMIN
  CLOSER
  SDR
  SS
}

// Os formatos de plano de comissão suportados pelo motor (Fase 5 + v1.2). A
// forma da `config` (JSONB) de cada tipo é validada por Zod em
// src/server/actions/planos-comissao.schemas.ts, nunca pelo Postgres.
enum PlanoTipo {
  percentual_fixo
  progressivo_atingimento
  fixo_variavel
  por_calls
  // v1.2: salário fixo + bônus por faixa de atingimento da meta (Closer Jr /
  // OTE) — bônus é valor FIXO em R$ por faixa, não percentual sobre vendas.
  salario_bonus_atingimento
}

// ============================================================
// ENUMS DA FASE 3 — venda e parcela
// ============================================================

enum Plataforma {
  ASAAS
  PAGARME
  INTER
  GURU
  OUTRO
}

enum TipoPagamento {
  A_VISTA
  MENSALISTA
}

// ============================================================
// FASE 11 — plano de pagamento estruturado (PGMT-01/02)
// ============================================================
// A forma de pagamento de cada COMPONENTE da negociação. Até a Fase 10 isso
// só existia como texto livre (`Venda.observacao`, copiado do WhatsApp) — era
// a maior fragilidade do processo e o que impedia calcular valor presente sem
// interpretação humana.
//
// O que decide se o dinheiro conta cheio no mês NÃO é a forma em si, é a Next
// já ter garantido o recebimento (regra confirmada com a gestão em
// 2026-08-02). CARTAO_PARCELADO e RECORRENCIA são os dois lados dessa
// distinção: um cartão parcelado em transação única foi aprovado inteiro pela
// operadora (o cliente não cancela o que falta); uma assinatura recorrente o
// cliente cancela quando quiser. Ver src/domain/vendas/componentes.ts.
enum FormaPagamento {
  PIX
  SINAL
  CARTAO_PARCELADO
  BOLETO
  RECORRENCIA
}

// De onde o registro veio. Reservado para as integrações (Asaas/GHL): um
// agendamento sincronizado do GHL não deve ser editável à mão como um
// lançamento manual, e um recebimento conciliado pelo Asaas precisa ser
// distinguível de um "marcar pago" digitado pelo admin.
enum OrigemRegistro {
  MANUAL
  GHL
  ASAAS
  IMPORTACAO
}

enum ParcelaTipo {
  ENTRADA
  MENSALIDADE
  AVISTA
}

// PENDENTE/PAGO são usados a partir da Fase 4 (marcar como recebido); aqui
// na Fase 3 toda parcela nasce PENDENTE.
enum StatusPagamento {
  PENDENTE
  PAGO
}

// ============================================================
// TABELAS GERENCIADAS PELO BETTER AUTH (auth: login, sessão, verificação)
// Shape conforme better-auth.com/docs/concepts/database para better-auth@1.6.23
// (Prisma adapter). Colunas adicionais (role/colaboradorId) configuradas via
// `additionalFields` em src/server/auth/auth.ts.
// ============================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  // additionalFields configurados em auth.ts — nunca setáveis pelo cliente
  // no signup (input: false); só um Admin, via server action, define estes valores.
  role          Papel
  colaboradorId String?      @unique
  colaborador   Colaborador? @relation(fields: [colaboradorId], references: [id])

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  password              String? // hash gerenciado pelo fluxo emailAndPassword do Better Auth
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// DOMÍNIO DA APLICAÇÃO — fatia da Fase 1
// ============================================================
// User (auth) e Colaborador (negócio) são modelos separados de propósito:
// Better Auth é dono de User/Session/Account/Verification (credenciais, sessão);
// Colaborador é dono das colunas de negócio (papel, ativo, contato, pix) e de
// toda FK futura (venda, plano_comissao, meta, agendamento). O vínculo 1:1 é
// User.colaboradorId → Colaborador.id.

model Colaborador {
  id       String  @id @default(cuid())
  nome     String
  email    String  @unique
  papel    Papel
  // `ativo=false` é o mecanismo de arquivamento (v1.1): soft-delete que
  // preserva todas as FKs históricas (vendas/parcelas/apurações/metas/
  // agendamentos) intactas. Reusa o flag já existente em vez de introduzir um
  // `arquivado` duplicado — listagens/selects de novas vendas filtram
  // `ativo=true` por padrão (arquivarColaborador em colaboradores.actions.ts);
  // exclusão real (`excluirColaborador`) só é permitida quando o colaborador
  // não tem NENHUM registro histórico vinculado.
  ativo    Boolean @default(true)
  telefone String?
  pix      String?

  // ---- Espaço reservado: integração GHL (Fase 16) ----
  // Id do usuário no GoHighLevel. É a chave que liga um agendamento do CRM à
  // pessoa daqui: a atribuição de pré-venda usa `createdBy.userId` do GHL
  // (NÃO `assignedUserId`, que é o closer dono do calendário — §8 do
  // documento de apuração).
  ghlUserId String? @unique

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Back-reference para a conta de login (1:1)
  user User?

  planosComissao PlanoComissao[]

  vendasComoCloser Venda[] @relation("VendaCloser")
  vendasComoSdr    Venda[] @relation("VendaSdr")
  vendasAprovadas  Venda[] @relation("VendaAprovadaPor")
  vendasCriadas    Venda[] @relation("VendaCriadaPor")

  comissoesApuradas ComissaoApurada[] @relation("ComissaoColaborador")

  agendamentos Agendamento[]

  metas Meta[]

  @@map("colaborador")
}

// Plano de comissão do colaborador — polimorfismo config-driven (ver
// ARCHITECTURE.md "Why config-driven JSONB"): uma tabela só, discriminada por
// `tipo`, com a `config` (JSONB) validada por Zod na camada de domínio, não
// pelo Postgres. Versionado por vigência: uma alteração de plano NUNCA
// sobrescreve a linha atual — fecha `vigenciaFim` da linha aberta e insere
// uma nova linha com `vigenciaInicio` no mês seguinte. Isso preserva o
// histórico exato de qual plano valia em cada mês para recomputar comissões
// passadas corretamente.
//
// Formas esperadas de `config` por `tipo` (validadas por
// src/server/actions/planos-comissao.schemas.ts):
//   percentual_fixo:          { percentual: number }
//     ex.: { "percentual": 0.03 }
//   progressivo_atingimento:  { faixas: [{ deAtingimento: number, percentual: number }] }
//     ex.: { "faixas": [{ "deAtingimento": 0, "percentual": 0.005 },
//                        { "deAtingimento": 0.70, "percentual": 0.01 },
//                        { "deAtingimento": 1.00, "percentual": 0.0125 }] }
//   fixo_variavel:            { valorFixo: number, percentualVariavel: number }
//     ex.: { "valorFixo": 2000.00, "percentualVariavel": 0.01 }
//   por_calls:                { valorPorCall: number }
//     ex.: { "valorPorCall": 15.00 }
//   salario_bonus_atingimento: { salarioFixo: number, faixas: [{ minAtingimento: number, bonus: number }] }
//     ATENÇÃO: minAtingimento é PERCENTUAL inteiro (71 = 71%), não fração —
//     diferente de deAtingimento (fração) do progressivo_atingimento acima.
//     ex.: { "salarioFixo": 4000.00, "faixas": [
//             { "minAtingimento": 0,   "bonus": 0 },
//             { "minAtingimento": 71,  "bonus": 2000 },
//             { "minAtingimento": 86,  "bonus": 3000 },
//             { "minAtingimento": 100, "bonus": 4000 },
//             { "minAtingimento": 120, "bonus": 5000 },
//             { "minAtingimento": 150, "bonus": 8000 },
//             { "minAtingimento": 200, "bonus": 12000 }] }
model PlanoComissao {
  id             String      @id @default(cuid())
  colaboradorId  String
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id])
  tipo           PlanoTipo
  config         Json
  vigenciaInicio DateTime    @db.Date
  vigenciaFim    DateTime?   @db.Date
  createdAt      DateTime    @default(now()) @db.Timestamptz
  updatedAt      DateTime    @updatedAt @db.Timestamptz

  comissoesApuradas ComissaoApurada[]

  // Índice único parcial (garante um único plano aberto por colaborador) é
  // criado via SQL bruto na migração — Prisma não suporta índice parcial
  // nativamente no schema. Ver prisma/migrations/*_add_plano_comissao.
  @@index([colaboradorId])
  @@map("plano_comissao")
}

// Categorias do catálogo v1.1 (ajustes pós-teste 2026-07): agrupam os
// produtos em programas de aceleração/mentoria, imersão presencial e
// eventos presenciais — usado hoje só como rótulo/filtro (sem lógica de
// comissão dependente da categoria). Nullable no schema para não quebrar
// produtos históricos importados sem categoria (Fase 10); os produtos
// recriados pelo reset de dados (scripts/reset-dados-2026-07.ts) sempre
// gravam a categoria.
enum CategoriaProduto {
  ACELERACAO_MENTORIA
  IMERSAO_PRESENCIAL
  EVENTO_PRESENCIAL
}

model Produto {
  id        String            @id @default(cuid())
  nome      String // START / PRO / MASTER / PADRAO / Elite
  categoria CategoriaProduto? // nullable: produtos históricos (Fase 10) não têm categoria
  ativo     Boolean           @default(true)
  createdAt DateTime          @default(now()) @db.Timestamptz
  updatedAt DateTime          @updatedAt @db.Timestamptz

  vendas Venda[]

  @@map("produto")
}

// ============================================================
// FASE 3 — venda e parcela (formulário único de venda)
// ============================================================
// Venda é a linha lançada uma única vez pelo gestor/closer (VENDA-01);
// Parcela é o cronograma gerado a partir dela (VENDA-02/VENDA-03), calculado
// pelo módulo puro src/domain/vendas/parcelas.ts (Fase 03-01).
//
// `fechado` é um placeholder da trava de edição da Fase 5 (apuração
// fechada bloqueia edição da venda) — nasce sempre false nesta fase.

// Fluxo de aprovação v1.1 (ajustes pós-teste 2026-07): vendas cadastradas por
// um ADMIN nascem já APROVADA (não muda o comportamento anterior nem o
// histórico importado — Fase 10 grava tudo como APROVADA). Vendas cadastradas
// por um CLOSER nascem PENDENTE_APROVACAO e só entram nas agregações de
// receita/comissão/dashboard depois que um ADMIN aprova (aprovarVenda/
// rejeitarVenda em vendas.actions.ts) — REJEITADA nunca conta, mas também
// nunca é apagada (fica visível na listagem para auditoria).
enum StatusAprovacao {
  PENDENTE_APROVACAO
  APROVADA
  REJEITADA
}

model Venda {
  id String @id @default(cuid())

  dataVenda DateTime @db.Date

  alunoNome   String
  pagadorNome String

  plataforma Plataforma

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  tipoPagamento TipoPagamento

  valorTotal       Decimal @db.Decimal(14, 2) // TCV — NUNCA usado para cálculo de comissão
  entrada          Decimal @default(0) @db.Decimal(14, 2)
  valorMensalidade Decimal @default(0) @db.Decimal(14, 2)
  numeroParcelas   Int     @default(1)
  diaVencimento    Int // âncora 1..31 — validação de faixa é responsabilidade do Zod (Pitfall 7)

  mesReferencia DateTime @db.Date // 1º dia do mês inicial (competência da venda) — campo próprio, nunca derivado de dataVenda (Pitfall 2)

  closerId String
  closer   Colaborador @relation("VendaCloser", fields: [closerId], references: [id])

  sdrId String?
  sdr   Colaborador? @relation("VendaSdr", fields: [sdrId], references: [id])

  observacao String?

  // Aprovação (v1.1): default APROVADA preserva o comportamento de todas as
  // vendas existentes/importadas/criadas por ADMIN sem exigir backfill.
  statusAprovacao StatusAprovacao @default(APROVADA)
  aprovadaPorId   String? // Colaborador do ADMIN que aprovou/rejeitou (nullable até a decisão)
  aprovadaPor     Colaborador?    @relation("VendaAprovadaPor", fields: [aprovadaPorId], references: [id])
  aprovadaEm      DateTime?       @db.Timestamptz
  criadaPorId     String? // Colaborador de quem criou a venda (nullable: histórico importado não tem)
  criadaPor       Colaborador?    @relation("VendaCriadaPor", fields: [criadaPorId], references: [id])
  linkCrm         String? // obrigatório (Zod) quando a venda é criada por um CLOSER

  fechado Boolean @default(false) // placeholder da trava de edição (Fase 5 integra com a apuração fechada)

  // ---- Fase 11: plano de pagamento estruturado ----
  // Os campos escalares acima (entrada/valorMensalidade/numeroParcelas) NÃO
  // foram removidos: 261 vendas históricas dependem deles e o backfill
  // (scripts/backfill-componentes.ts) os usa como fonte da conversão. Para
  // vendas NOVAS eles passam a ser derivados dos componentes — a fonte de
  // verdade do plano de pagamento é `componentes`, não mais os escalares.
  componentes ComponentePagamento[]

  origem OrigemRegistro @default(MANUAL)

  // ---- Espaço reservado: integração GHL (Fase 16) ----
  // Preenchidos pela sincronização de oportunidades ganhas. `@unique` no
  // opportunityId torna o sync idempotente por construção (Postgres permite
  // múltiplos NULLs numa coluna UNIQUE, então vendas manuais não colidem).
  ghlOpportunityId String? @unique
  ghlContactId     String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  parcelas Parcela[]

  @@index([closerId])
  @@index([sdrId])
  @@index([mesReferencia])
  @@index([statusAprovacao])
  @@index([ghlContactId])
  @@map("venda")
}

// Um componente do plano de pagamento de uma venda (PGMT-01). Uma venda tem N.
//
// É o dado que não existia estruturado em lugar nenhum antes da Fase 11 — o
// que permite calcular valor presente sem ninguém interpretar texto livre.
// Exemplos reais que exigem mais de um componente:
//   Karen ....... 72k PIX + 72k em 12x no cartão
//   Rafaela ..... 5k de sinal + 25k em 03/08 + 30k de recorrência em 6x
//   Patrícia .... 25k cartão (jun) + 25k cartão (jul) + 46k em boleto
//
// `mesPrevisto` é gravado EXPLICITAMENTE (nunca derivado de `dataPrevista` no
// read — Pitfall 2, mesma disciplina de Venda.mesReferencia), e é o que
// implementa a ressalva 3 do documento de apuração: um componente datado em
// agosto não entra no valor presente de julho, mesmo numa venda de julho.
model ComponentePagamento {
  id String @id @default(cuid())

  vendaId String
  venda   Venda  @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  // Ordem de exibição/numeração dentro da venda (0-based). Faz parte da chave
  // natural para o backfill ser idempotente.
  ordem Int

  forma FormaPagamento

  // O discriminante da regra de valor presente. Derivado da `forma` por
  // padrão (CONTA_CHEIO_POR_PADRAO em src/domain/vendas/componentes.ts), mas
  // gravado explicitamente para permitir o caso raro que foge do padrão sem
  // exigir migração nem uma forma nova.
  contaCheioNoMes Boolean

  valor    Decimal @db.Decimal(14, 2) // valor TOTAL do componente, não da parcela
  parcelas Int     @default(1) // em quantas vezes é cobrado (1 = à vista)

  dataPrevista DateTime @db.Date // a data DESTE componente
  mesPrevisto  DateTime @db.Date // 1º dia do mês de dataPrevista, gravado explicitamente

  // Texto livre explicando a negociação ("3 cartões diferentes", "boleto em
  // aberto com o financeiro"). Negociações fora do padrão são comuns e
  // precisam ser explicáveis — antes disso só existiam no WhatsApp.
  descricao String?

  // ---- Espaço reservado: integração Asaas (Fase 15) ----
  // Id da cobrança/assinatura no gateway que representa ESTE componente
  // (`pay_xxx` ou `sub_xxx` no Asaas). É por aqui que a conciliação encontra
  // as parcelas reais de um cartão parcelado ou de uma recorrência.
  gatewayChargeId String? @unique

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  parcelasGeradas Parcela[]

  @@unique([vendaId, ordem])
  @@index([mesPrevisto])
  @@index([vendaId])
  @@map("componente_pagamento")
}

// Colunas de recebimento (statusPagamento/valorRecebido/dataPagamento) já
// existem a partir desta migração, mas a lógica de marcar-pago pertence à
// Fase 4 — nesta fase toda parcela nasce PENDENTE com valorRecebido e
// dataPagamento null, evitando uma migração de tipo depois.
model Parcela {
  id String @id @default(cuid())

  vendaId String
  venda   Venda  @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  tipo   ParcelaTipo
  numero Int // 0 para ENTRADA/AVISTA; 1..N para MENSALIDADE

  mesReferencia  DateTime @db.Date // competência (1º dia do mês)
  dataVencimento DateTime @db.Date // já ancorada/clampada pelo domínio (03-01)

  valorPrevisto Decimal @db.Decimal(14, 2)

  statusPagamento StatusPagamento @default(PENDENTE)
  valorRecebido   Decimal?        @db.Decimal(14, 2) // null até pago (Fase 4)
  dataPagamento   DateTime?       @db.Date // null até pago (Fase 4)

  // ---- Fase 11: rastreabilidade até o componente de origem ----
  // Nullable porque as 1.454 parcelas históricas (Fase 10) nasceram antes dos
  // componentes existirem. NÃO faz parte da unique key: a numeração
  // (`numero`) já é sequencial por tipo dentro da venda atravessando
  // componentes, justamente para preservar `[vendaId, tipo, numero]` intacta.
  //
  // É o que permite ao cálculo de valor presente saber se esta parcela veio
  // de um componente que já foi contado cheio (e portanto NÃO deve somar de
  // novo — a dupla contagem do problema #5 da planilha).
  componenteId String?
  componente   ComponentePagamento? @relation(fields: [componenteId], references: [id], onDelete: SetNull)

  origem OrigemRegistro @default(MANUAL)

  // ---- Espaço reservado: integração Asaas/Pagar.me (Fase 15) ----
  // CONCIL-01: conciliação por id de transação do gateway, nunca por nome de
  // aluno (problema #7 da planilha). `@unique` garante que o mesmo pagamento
  // não seja conciliado duas vezes, mesmo rodando o import repetido.
  gatewayTransactionId  String?   @unique
  gatewaySincronizadoEm DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([vendaId, tipo, numero])
  @@index([mesReferencia])
  @@index([statusPagamento])
  @@index([componenteId])
  @@map("parcela")
}

// ============================================================
// FASE 5 — apuração de comissão (snapshot imutável) + trilha de auditoria
// ============================================================
// ComissaoApurada é a SAÍDA persistida do motor puro (src/domain/comissao,
// Fase 05-01) — uma linha por (colaborador, mesReferencia). mesReferencia
// (competência) e mesPagamento (competência + 1 mês) são gravados
// EXPLICITAMENTE aqui, nunca derivados no read-time (Pitfall 2/COMIS-04).
// inputSnapshot guarda o ComissaoInput completo usado no cálculo, permitindo
// auditoria/replay sem recalcular sobre dados que podem já ter mudado
// (Pitfall 4/COMIS-05). A IMUTABILIDADE após FECHADA é imposta na camada de
// service (05-03), não pelo banco: o índice único permite upsert da linha
// ABERTA (recomputa livremente); uma vez FECHADA o service recusa escrita
// (COMIS-06) — reabertura é ação explícita registrada em AuditLog.

enum StatusApuracao {
  ABERTA
  FECHADA
}

model ComissaoApurada {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation("ComissaoColaborador", fields: [colaboradorId], references: [id])

  mesReferencia DateTime @db.Date // competência (1º dia do mês)
  mesPagamento  DateTime @db.Date // mesReferencia + 1 mês, GRAVADO EXPLICITAMENTE (Pitfall 2/COMIS-04) — nunca derivado no read

  planoComissaoId String // qual VERSÃO de plano foi usada (histórico intacto)
  plano           PlanoComissao @relation(fields: [planoComissaoId], references: [id])
  tipoPlano       PlanoTipo

  valorBase          Decimal  @db.Decimal(14, 2) // recebido no mês OU nº de calls (quando por_calls) — nunca TCV
  percentualAplicado Decimal? @db.Decimal(6, 4) // null quando por_calls
  valorComissao      Decimal  @db.Decimal(14, 2) // saída do motor, já arredondada uma vez

  inputSnapshot Json // ComissaoInput completo usado — auditoria/replay (COMIS-05, AUDIT-01)

  // Observação livre editável no fechamento (v1.1) — anotação humana por
  // pessoa/mês (ex.: ajuste combinado, justificativa de divergência), nunca
  // usada no CÁLCULO (o motor puro nunca lê este campo).
  observacao String?

  status StatusApuracao @default(ABERTA)

  calculadoEm  DateTime  @default(now()) @db.Timestamptz
  calculadoPor String? // userId (better-auth) de quem rodou a apuração
  fechadoEm    DateTime? @db.Timestamptz
  fechadoPor   String? // userId de quem fechou o mês

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([colaboradorId, mesReferencia]) // 1 linha por pessoa/mês; recomputa a ABERTA, nunca a FECHADA (regra no service 05-03)
  @@index([mesPagamento]) // "o que é pagável neste mês" vira WHERE mesPagamento = X
  @@index([mesReferencia])
  @@map("comissao_apurada")
}

// Trilha de alterações que afetam comissão (AUDIT-01) — marcar parcela como
// paga, editar venda, trocar plano, fechar/reabrir apuração e a própria
// apuração ficam registradas aqui com quem/quando/antes/depois.
enum AcaoAudit {
  MARCAR_PAGO
  REVERTER_PAGO
  EDITAR_VENDA
  TROCAR_PLANO
  FECHAR_APURACAO
  REABRIR_APURACAO
  APURAR_COMISSAO
  DEFINIR_META
  APROVAR_VENDA
  REJEITAR_VENDA
  ARQUIVAR_COLABORADOR
  EXCLUIR_COLABORADOR
}

// ============================================================
// FASE 7 — agendamentos SDR/SS (AGEND-01/02/03)
// ============================================================
// Agendamento é lançado pelo próprio SDR/SS (ou por um ADMIN em nome dele) —
// uma linha por chamada agendada, com status que evolui até o dia da call.
// `contarCallsRealizadas` (src/domain/agendamentos/agregacao.ts) é a FONTE
// ÚNICA que soma status=REALIZADO no mês; tanto a apuração por_calls (Fase
// 5) quanto o painel de meta (Fase 6/8) leem essa MESMA contagem — nunca
// dois caminhos de soma divergentes (AGEND-02).

enum StatusAgendamento {
  AGENDADO
  REALIZADO
  NO_SHOW
  CANCELADO
}

model Agendamento {
  id String @id @default(cuid())

  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])

  data   DateTime          @db.Date // dia da call agendada (DATE puro, Pitfall 6)
  status StatusAgendamento @default(AGENDADO)

  observacao String?

  origem OrigemRegistro @default(MANUAL)

  // ---- Espaço reservado: integração GHL (Fase 16) ----
  // GHL-01: "agendada" é 1x por lead, deduplicada por `contactId` —
  // reagendamento NÃO reconta. Por isso o contactId é indexado: a dedup é uma
  // query, não um pós-processamento em memória.
  // `ghlAppointmentId` @unique torna o sync idempotente.
  ghlAppointmentId String? @unique
  ghlContactId     String?
  ghlCalendarId    String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([colaboradorId, data])
  @@index([ghlContactId])
  @@index([ghlCalendarId])
  @@map("agendamento")
}

// ============================================================
// ESPAÇO RESERVADO PARA AS INTEGRAÇÕES (Fases 15 e 16)
// ============================================================
// Nenhuma das duas está implementada. Estas tabelas existem para que a
// integração NÃO exija uma segunda migração destrutiva depois — mesma
// disciplina já usada na Fase 3, que criou as colunas de recebimento da Fase
// 4 antecipadamente.

// GHL-02: quais calendários do GoHighLevel contam como pré-venda.
// Não é constante no código porque muda sem deploy (a Next cria calendário
// novo quando entra gente no time). Os ids reais estão na §8 de
// docs/APURACAO-COMERCIAL-NEXT.md — D&F (reunião de proposta) e Pós-Vendas
// NUNCA contam como agendamento de pré-venda.
model CalendarioGhl {
  id String @id @default(cuid())

  ghlCalendarId String  @unique
  nome          String
  // false = existe no CRM mas não entra na apuração (D&F, Pós-Vendas)
  apuravel      Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("calendario_ghl")
}

// Trilha de execução das sincronizações (Asaas e GHL).
// CONCIL-03: divergência entre o extrato e as parcelas do sistema vira
// relatório explícito, nunca é aceita em silêncio. `relatorio` (JSONB) guarda
// o detalhamento do que não casou, no mesmo espírito de
// ComissaoApurada.inputSnapshot — auditável depois, sem reprocessar.
model SincronizacaoIntegracao {
  id String @id @default(cuid())

  // "ASAAS" | "PAGARME" | "GURU" | "GHL" — string livre em vez de enum para
  // não exigir migração ao plugar um gateway novo.
  sistema String

  iniciadaEm  DateTime  @default(now()) @db.Timestamptz
  concluidaEm DateTime? @db.Timestamptz

  // "EM_ANDAMENTO" | "CONCLUIDA" | "FALHOU"
  status String @default("EM_ANDAMENTO")

  registrosLidos       Int @default(0)
  registrosConciliados Int @default(0)
  divergencias         Int @default(0)

  relatorio Json?
  erro      String?

  executadaPor String? // userId (better-auth); null quando roda por cron

  @@index([sistema, iniciadaEm])
  @@map("sincronizacao_integracao")
}

// ============================================================
// FASE 6 — metas mensais + proração semanal (META-01/02/03/04)
// ============================================================
// Meta é definida pelo ADMIN, uma linha por (colaborador, mesReferencia).
// A UNIDADE é detectada pelo papel do colaborador no momento da definição
// (CLOSER -> VALOR em R$; SDR/SS -> AGENDAMENTOS, nº de calls) — nunca
// escolhida livremente pelo formulário, para não permitir um closer com
// meta em "calls" por engano. `valorMeta` (Decimal, R$) e `metaAgendamentos`
// (Int) são mutuamente exclusivos conforme `unidade` — reforçado por CHECK
// no banco (mesmo padrão XOR do ARCHITECTURE.md) e por Zod na camada de
// domínio. A proração semanal (META-02) é uma função PURA
// (src/domain/metas/proracao.ts) recalculada em cada leitura a partir desta
// linha — não há tabela de "meta semanal" persistida (ARCHITECTURE.md:
// "recomputado no read, cheap, sem necessidade de snapshot histórico").

enum MetaUnidade {
  VALOR
  AGENDAMENTOS
}

model Meta {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])

  mesReferencia DateTime @db.Date // 1º dia do mês (competência)

  unidade          MetaUnidade
  valorMeta        Decimal?    @db.Decimal(14, 2) // usado quando unidade = VALOR (closer, R$)
  metaAgendamentos Int? // usado quando unidade = AGENDAMENTOS (SDR/SS, nº de calls)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([colaboradorId, mesReferencia])
  @@index([mesReferencia])
  @@map("meta")
}

model AuditLog {
  id            String    @id @default(cuid())
  acao          AcaoAudit
  entidade      String // nome da entidade afetada: "parcela" | "venda" | "plano_comissao" | "comissao_apurada"
  entidadeId    String // id do registro afetado
  colaboradorId String? // colaborador impactado (quando aplicável) — facilita filtrar o histórico por pessoa
  usuarioId     String? // userId (better-auth) de quem executou; null p/ ações de sistema
  dadosAntes    Json? // estado relevante antes (quando aplicável)
  dadosDepois   Json? // estado relevante depois
  criadoEm      DateTime  @default(now()) @db.Timestamptz

  @@index([entidade, entidadeId])
  @@index([colaboradorId])
  @@index([criadoEm])
  @@map("audit_log")
}
